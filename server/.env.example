# Hindsight Persistent Memory Configuration (Vectorize.io)
# Register at https://ui.hindsight.vectorize.io
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BANK_PREFIX=hok

# LLM Configuration (Groq recommended for ultra-fast inference)
# Get key at https://groq.com
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b

# Server Port
PORT=5000
